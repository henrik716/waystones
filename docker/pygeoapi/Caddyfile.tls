{
    auto_https off
}

import /etc/caddy/Caddyfile

# Public TLS terminator. Used by the SaaS path where each fly machine receives
# the Edge SSL Certificate via TLS_CERT_FILE / TLS_KEY_FILE. Visitors
# hit the Global Edge (Universal SSL) and the platform connects here over the
# origin cert; this block is what the Edge Proxy talks to. The reverse_proxy
# hands the request to the existing :5000 plain-HTTP site that already does
# all the routing.
:443 {
    tls {$TLS_CERT_FILE} {$TLS_KEY_FILE}
    reverse_proxy localhost:5000
}
